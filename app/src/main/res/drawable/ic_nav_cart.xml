<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Speed Lines -->
    <path
        android:pathData="M3,8 L6,8 M2,11 L5,11 M3,14 L6,14"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeColor="#FFFF7A00" />

    <!-- Shopping Cart Body -->
    <path
        android:pathData="M7,6 L19,6 L17,14 L9,14 Z"
        android:strokeWidth="1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="7"
                android:startY="6"
                android:endX="19"
                android:endY="14"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF5252" />
                <item android:offset="0.5" android:color="#FFD0108A" />
                <item android:offset="1.0" android:color="#FF0072FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Handle -->
    <path
        android:pathData="M19,6 L21,3"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#FF00B4D8" />

    <!-- Wheels -->
    <path
        android:pathData="M10,18 A1.8,1.8 0 1,1 10,17.9 Z"
        android:fillColor="#FF00B4D8" />
    <path
        android:pathData="M16,18 A1.8,1.8 0 1,1 16,17.9 Z"
        android:fillColor="#FF00B4D8" />
</vector>